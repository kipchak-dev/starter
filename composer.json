{
    "name": "kipchak/starter",
    "description": "Kipchak API Development Kit (ADK) Starter Project",
    "type": "project",
    "homepage": "https://kipchak.dev",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "kipchak/core": "^3.17.1",
        "kipchak/driver-config": "^1.33",
        "kipchak/driver-logger": "^1.38",
        "kipchak/middleware-error": "^1.32"
    },
    "require-dev": {
        "kipchak/cli": "^1.2.3",
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "openapi": "php bin/openapi openapi.yaml"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
